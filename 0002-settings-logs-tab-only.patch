+                                        color = colorResource(id = R.color.text_secondary)
+                                    )
+                                    Text(
+                                        text = "${stringResource(id = R.string.logs_tool_history_tool)}: ${row.toolName}",
+                                        fontWeight = FontWeight.SemiBold
+                                    )
