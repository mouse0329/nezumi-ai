             args.append("--weightQuantAsymmetric")
         if quant_block > 0:
             args += ["--weightQuantBlock", str(quant_block)]
+
+    # 実行時 (画像生成時) に .mnn を1回の巨大な連続mallocで丸ごと読み込むのを避けるため、
+    # 重みを外部ファイル (.mnn.weight) に分離する。これによりテンソル単位の小さな
