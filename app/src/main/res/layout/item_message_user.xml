<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end" android:layout_margin="8dp">

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">

        <!-- Media Preview Container - 複数画像対応 -->
        <LinearLayout android:id="@+id/media_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:visibility="gone" android:orientation="vertical">
            <!-- 複数画像用横スクロールビュー（送信前と同じレイアウト） -->
            <HorizontalScrollView android:id="@+id/image_scroll_view" android:layout_width="400dp" android:layout_height="180dp" android:visibility="gone" android:scrollbars="none" android:background="@android:color/transparent" android:paddingStart="8dp" android:paddingEnd="8dp">
                <LinearLayout android:id="@+id/image_container" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" />
            </HorizontalScrollView>
            <!-- 単一画像用（後方互換性） -->
            <FrameLayout android:id="@+id/single_image_container" android:layout_width="200dp" android:layout_height="200dp" android:visibility="gone" android:background="@drawable/bg_message_user" android:foreground="?attr/selectableItemBackground">
                <ImageView android:id="@+id/user_image_preview" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="@string/message_image" />
            </FrameLayout>
            <!-- Audio Playback Button -->
            <LinearLayout android:id="@+id/audio_playback_container" android:layout_width="200dp" android:layout_height="200dp" android:layout_marginTop="8dp" android:orientation="vertical" android:gravity="center" android:visibility="gone" android:background="@color/primary">
                <com.google.android.material.button.MaterialButton android:id="@+id/user_audio_play_button" style="@style/Widget.MaterialComponents.Button" android:layout_width="56dp" android:layout_height="56dp" android:text="▶" android:textSize="24sp" android:textColor="@color/white" android:insetTop="0dp" android:insetBottom="0dp" />
                <TextView android:id="@+id/user_audio_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0:00" android:textColor="@color/white" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/user_message_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="User message" android:textSize="14sp" android:textColor="@color/white" android:background="@drawable/bg_message_user" android:padding="11dp" android:maxWidth="280dp" android:textIsSelectable="true" />

        <TextView android:id="@+id/user_message_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14:25" android:textSize="11sp" android:textColor="@color/text_secondary" android:layout_marginTop="3dp" android:layout_marginEnd="4dp" />

        <!-- Bug fix(#Action-Row-Declutter): 常時表示だったコピー/取り消しボタンを
               吹き出しタップ時のみ表示するトグル方式に変更。既定は非表示 (GONE) とし、
               アダプター側で bubble のクリックリスナーから可視性を切り替える。
               revoke ボタンは copy と同じアイコンボタン形式に統一し、枠線付き
               MaterialButton の見た目の不一致を解消した。 -->
        <LinearLayout android:id="@+id/message_actions_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:visibility="gone">

            <ImageView android:id="@+id/copy_message_button" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/content_copy_24" android:scaleType="centerInside" android:padding="4dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/copy_all" android:clickable="true" android:focusable="true" app:tint="@color/text_secondary" />

            <ImageView android:id="@+id/revoke_prompt_button" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_close" android:scaleType="centerInside" android:padding="6dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/revoke_prompt" android:clickable="true" android:focusable="true" app:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

