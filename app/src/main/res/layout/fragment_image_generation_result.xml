<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" tools:context=".presentation.ui.fragment.ImageGenerationResultFragment">

    <!-- ヘッダー -->
    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/accent_blue" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">

        <ImageButton android:id="@+id/back_button" android:layout_width="24dp" android:layout_height="24dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_arrow_back_24" android:contentDescription="戻る" android:scaleType="centerInside" android:layout_marginEnd="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="画像生成 (SD)" android:textColor="@android:color/white" android:textStyle="bold" android:textSize="16sp" />
    </LinearLayout>

    <!-- メインコンテンツ -->
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="?attr/actionBarSize">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <!-- 入力パネル -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_config_panel" android:padding="12dp" android:layout_marginBottom="20dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="プロンプト" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_prompt_view" android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="12dp">

                    <TextView android:id="@+id/prompt_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="rat" android:textColor="@color/text_primary" android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton android:id="@+id/retry_button" android:layout_width="match_parent" android:layout_height="40dp" android:text="再生成" android:textSize="13sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:icon="@drawable/ic_refresh_24" app:iconGravity="textStart" app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- 生成画像 -->
            <ImageView android:id="@+id/result_image" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="300dp" android:maxHeight="500dp" android:background="@color/input_border" android:scaleType="centerCrop" android:contentDescription="生成された画像" android:layout_marginBottom="16dp" />

            <!-- アクションボタングループ -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:spacing="12dp" android:layout_marginBottom="20dp">

                <com.google.android.material.button.MaterialButton android:id="@+id/save_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="保存" android:textSize="13sp" style="@style/Widget.MaterialComponents.Button" app:icon="@drawable/ic_save_24" app:iconGravity="textStart" app:cornerRadius="10dp" android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton android:id="@+id/share_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="共有" android:textSize="13sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:icon="@drawable/ic_share_24" app:iconGravity="textStart" app:cornerRadius="10dp" android:layout_marginStart="6dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>