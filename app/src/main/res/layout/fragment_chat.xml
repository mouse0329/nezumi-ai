<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_chat">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

        <!-- Chat Header -->
        <LinearLayout android:id="@+id/chat_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical" android:background="@color/surface_card">

            <ImageButton android:id="@+id/back_button" android:layout_width="36dp" android:layout_height="36dp" android:scaleType="centerInside" android:src="@drawable/ic_menu" android:background="@drawable/bg_back_button" android:contentDescription="@string/open_sidebar" />

            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_nezumi_ai" android:contentDescription="@string/app_name" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:scaleType="centerInside" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">

                <TextView android:id="@+id/chat_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_title" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" android:ellipsize="end" android:singleLine="true" />

                <TextView android:id="@+id/model_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/model_not_downloaded" android:textSize="13sp" android:textColor="@color/text_secondary" android:ellipsize="end" android:singleLine="true" />
            </LinearLayout>

            <androidx.compose.ui.platform.ComposeView android:id="@+id/header_actions_compose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
        </LinearLayout>

        <androidx.compose.ui.platform.ComposeView android:id="@+id/context_meter_compose" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <!-- Messages Container -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/messages_recycler_view" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:clipToPadding="false" />

            <androidx.compose.ui.platform.ComposeView android:id="@+id/empty_state_compose" android:layout_width="match_parent" android:layout_height="match_parent" />

            <!-- Overlay layer: typing indicator + tool progress (bottom) / scroll button (top) -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

                <!-- タイピング・ツール進捗: 常に最下部に縦積み -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical">

                    <androidx.compose.ui.platform.ComposeView android:id="@+id/response_typing_compose" android:layout_width="match_parent" android:layout_height="wrap_content" />

                    <androidx.compose.ui.platform.ComposeView android:id="@+id/tool_call_progress_compose" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
                </LinearLayout>

                <androidx.compose.ui.platform.ComposeView android:id="@+id/scroll_to_bottom_compose" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" />

            </FrameLayout>
        </FrameLayout>

        <!-- Media Preview Bar -->
        <androidx.compose.ui.platform.ComposeView android:id="@+id/media_preview_compose" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/surface_card" />

        <!-- Input Bar -->
        <LinearLayout
            android:id="@+id/input_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_card"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/input_bar_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_bar_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageButton
                    android:id="@+id/media_menu_button"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_plus_btn_circle"
                    android:contentDescription="@string/add_media_menu"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_add"
                    android:tint="@color/nezumi_primary" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp">

                    <com.nezumi_ai.presentation.ui.widget.ClipboardAwareEditText
                        android:id="@+id/message_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="@string/enter_message"
                        android:imeOptions="actionSend"
                        android:maxLines="6"
                        android:minHeight="36dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:scrollbars="vertical"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp" />

                    <!-- 録音中バー: EditTextに重ねて表示 (visibility toggle) -->
                    <LinearLayout
                        android:id="@+id/inline_record_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@color/surface_card"
                        android:gravity="center_vertical"
                        android:minHeight="36dp"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/inline_record_cancel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackground"
                            android:padding="4dp"
                            android:text="削除"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <View
                            android:id="@+id/inline_record_dot"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_record_dot" />

                        <TextView
                            android:id="@+id/inline_record_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="0:00"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="22dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/inline_wave_1"
                                android:layout_width="3dp"
                                android:layout_height="9dp"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/bg_wave_bar" />
                            <View
                                android:id="@+id/inline_wave_2"
                                android:layout_width="3dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/bg_wave_bar" />
                            <View
                                android:id="@+id/inline_wave_3"
                                android:layout_width="3dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/bg_wave_bar" />
                            <View
                                android:id="@+id/inline_wave_4"
                                android:layout_width="3dp"
                                android:layout_height="21dp"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/bg_wave_bar" />
                            <View
                                android:id="@+id/inline_wave_5"
                                android:layout_width="3dp"
                                android:layout_height="8dp"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/bg_wave_bar" />
                            <View
                                android:id="@+id/inline_wave_6"
                                android:layout_width="3dp"
                                android:layout_height="15dp"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/bg_wave_bar" />
                            <View
                                android:id="@+id/inline_wave_7"
                                android:layout_width="3dp"
                                android:layout_height="11dp"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/bg_wave_bar" />
                            <View
                                android:id="@+id/inline_wave_8"
                                android:layout_width="3dp"
                                android:layout_height="19dp"
                                android:background="@drawable/bg_wave_bar" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <ImageButton
                    android:id="@+id/mic_button"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_mic_btn_circle"
                    android:contentDescription="音声入力"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/send_button"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_send_btn_circle"
                    android:contentDescription="@string/send_icon"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_send" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Model loading full-screen overlay（非ロード時は GONE。Compose が空でも View がタッチを奪うため） -->
    <androidx.compose.ui.platform.ComposeView android:id="@+id/model_loading_compose_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />

</FrameLayout>
