<?xml version="1.0" encoding="utf-8"?>
<!--
    前回起動時に発生したクラッシュのスタックトレースを表示するモーダル。
    dialog_welcome.xml と同系統の縦積みレイアウト + ScrollView を踏襲し、
    ダイアログのボタン (閉じる / コピー / 共有) は AlertDialog.Builder 側で付与する。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- タイトル -->
    <TextView
        android:id="@+id/crash_title_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/crash_dialog_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- サブタイトル (発生時刻) -->
    <TextView
        android:id="@+id/crash_subtitle_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        tools:ignore="MissingDefaultResource"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- 例外サマリー (クラス名 : メッセージ) -->
    <TextView
        android:id="@+id/crash_summary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="?attr/colorOnBackground"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- スタックトレース本体 (スクロール可能) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:background="?attr/colorSurfaceVariant"
        android:padding="8dp">

        <TextView
            android:id="@+id/crash_stack_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

</LinearLayout>
