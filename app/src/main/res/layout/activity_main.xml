<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:id="@+id/drawer_layout" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" tools:context=".MainActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">

        <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:fitsSystemWindows="true">

            <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" />

        </com.google.android.material.appbar.AppBarLayout>

        <include layout="@layout/content_main" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_marginEnd="@dimen/fab_margin" android:layout_marginBottom="16dp" app:srcCompat="@android:drawable/ic_dialog_email" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <LinearLayout android:id="@+id/drawer_panel" android:layout_width="280dp" android:layout_height="match_parent" android:layout_gravity="start" android:background="@color/bg_session_list" android:fitsSystemWindows="true" android:orientation="vertical" android:padding="16dp">

        <!-- ロゴセクション -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingBottom="24dp">

            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:contentDescription="@string/app_name" android:scaleType="centerInside" android:src="@drawable/ic_nezumi_ai" />

            <TextView android:id="@+id/drawer_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_name" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />

            <ImageButton android:id="@+id/drawer_search_button" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="履歴検索" android:padding="6dp" android:src="@drawable/ic_search" android:tint="@color/text_primary" />
        </LinearLayout>

        <!-- クイックナビ（設定・モデル・プリセット）横並び -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="20dp">

            <com.google.android.material.button.MaterialButton android:id="@+id/drawer_settings_button" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:padding="0dp" android:text="@string/action_settings" android:textSize="11sp" android:textColor="@color/drawer_text" app:iconTint="@color/drawer_text" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:icon="@drawable/settings_24" app:iconGravity="textStart" app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton android:id="@+id/drawer_model_button" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:layout_marginStart="0dp" android:padding="0dp" android:text="@string/model_settings" android:textSize="11sp" android:textColor="@color/drawer_text" app:iconTint="@color/drawer_text" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:icon="@drawable/deployed_code_24" app:iconGravity="textStart" app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton android:id="@+id/drawer_tools_button" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="0dp" android:padding="0dp" android:text="@string/drawer_preset_button" android:textSize="11sp" android:textColor="@color/drawer_text" app:iconTint="@color/drawer_text" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:icon="@drawable/ic_nezumi_ai" app:iconGravity="textStart" app:cornerRadius="6dp" />
        </LinearLayout>

        <!-- 新規セッションボタン（プライマリ） -->
        <com.google.android.material.button.MaterialButton android:id="@+id/drawer_new_chat_button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="8dp" android:text="@string/new_session" android:textStyle="bold" android:textColor="@color/drawer_text" app:iconTint="@color/drawer_text" app:icon="@drawable/ic_add" app:iconGravity="textStart" app:cornerRadius="8dp" style="@style/Widget.MaterialComponents.Button" />

        <!-- サブアクション（シークレット・画像生成）横並び -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton android:id="@+id/drawer_incognito_button" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:padding="0dp" android:text="@string/drawer_incognito_button" android:textSize="12sp" android:textColor="@color/drawer_text" app:iconTint="@color/drawer_text" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:icon="@drawable/ic_menu" app:iconGravity="textStart" app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton android:id="@+id/drawer_image_gen_button" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="0dp" android:padding="0dp" android:text="@string/drawer_image_gen_start" android:textSize="12sp" android:textColor="@color/drawer_text" app:iconTint="@color/drawer_text" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:icon="@android:drawable/ic_menu_gallery" app:iconGravity="textStart" app:cornerRadius="6dp" />
        </LinearLayout>

        <TextView android:id="@+id/drawer_history_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingBottom="8dp" android:text="@string/drawer_history_label" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/drawer_history_recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp" />

        <TextView android:id="@+id/drawer_history_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="16dp" android:text="@string/drawer_history_empty" android:textColor="@color/text_secondary" android:visibility="gone" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
