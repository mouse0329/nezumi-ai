<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.ui.fragment.ImageGenerationFragment">

    <!-- ヘッダー -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/accent_blue"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_24"
            android:contentDescription="戻る"
            android:scaleType="centerInside"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="画像生成 (SD)"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- スクロール可能なコンテンツ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_marginBottom="80dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SDモデル選択セクション -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SDモデル選択 (* safetensorsをサポート)"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/model_spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_signal_cellular_24"
                    android:contentDescription=""
                    android:layout_marginEnd="4dp"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/model_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unknown | LocalDream"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- プロンプトセクション -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="プロンプト"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/prompt_input"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_input_field"
                android:hint="どのような画像を生成しますか？"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:padding="12dp"
                android:gravity="top"
                android:maxLines="6"
                android:textSize="15sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/negative_prompt_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶ ネガティブプロンプトを入力"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- ネガティブプロンプト（初期非表示） -->
            <LinearLayout
                android:id="@+id/negative_prompt_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/negative_prompt_input"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="除外したい要素を入力"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:padding="12dp"
                    android:gravity="top"
                    android:maxLines="5"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 出力サイズセクション -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="出力サイズ: "
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/size_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="512x512"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/size_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="40dp"
                android:spacing="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/size_256"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="256x256"
                    android:textSize="12sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginEnd="4dp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/size_512"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="512x512"
                    android:textSize="12sp"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/size_768"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="768x768"
                    android:textSize="12sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginStart="4dp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 固定フッターアクション -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/generate_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="画像を生成する"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button" />
    </LinearLayout>

</FrameLayout>