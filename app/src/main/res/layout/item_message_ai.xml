<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/ai_message_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="start" android:layout_margin="8dp">

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="start">

        <!-- Media Preview Container - 複数画像対応 -->
        <LinearLayout android:id="@+id/media_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:visibility="gone" android:orientation="vertical">
            <!-- 複数画像用横スクロールビュー（送信前と同じレイアウト） -->
            <HorizontalScrollView android:id="@+id/image_scroll_view" android:layout_width="400dp" android:layout_height="180dp" android:visibility="gone" android:scrollbars="none" android:background="@android:color/transparent" android:paddingStart="8dp" android:paddingEnd="8dp">
                <LinearLayout android:id="@+id/image_container" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" />
            </HorizontalScrollView>
            <!-- 単一画像用（後方互換性） -->
            <FrameLayout android:id="@+id/single_image_container" android:layout_width="200dp" android:layout_height="200dp" android:visibility="gone" android:background="@drawable/bg_message_ai" android:foreground="?attr/selectableItemBackground">
                <ImageView android:id="@+id/ai_image_preview" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="@string/message_image" />
            </FrameLayout>
            <!-- Audio Playback Button -->
            <LinearLayout android:id="@+id/audio_playback_container" android:layout_width="200dp" android:layout_height="200dp" android:layout_marginTop="8dp" android:orientation="vertical" android:gravity="center" android:visibility="gone" android:background="@color/primary">
                <com.google.android.material.button.MaterialButton android:id="@+id/ai_audio_play_button" style="@style/Widget.MaterialComponents.Button" android:layout_width="56dp" android:layout_height="56dp" android:text="▶" android:textSize="24sp" android:textColor="@color/white" android:insetTop="0dp" android:insetBottom="0dp" />
                <TextView android:id="@+id/ai_audio_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0:00" android:textColor="@color/white" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- AI Edge Gallery の MessageBodyThinking に相当: タップで開閉、ストリーミング中は常に展開 -->
        <!-- Bug fix(#Thinking-Layout):
               旧実装は wrap_content + maxWidth=280dp を指定していたが、内部の
               ai_thinking_markdown_compose (GalleryMarkdownText の widthIn(max=280dp)) が
               親のパディング/縦線ぶんを無視して膨張し、Thinking ブロックが親コンテナから
               はみ出す問題があった。ここでは固定の layout_width=280dp と android:clipChildren="true"
               を明示し、内部 ComposeView にも maxWidth を設けて完全に枠内へ収める。 -->
        <LinearLayout android:id="@+id/ai_thinking_block" android:layout_width="280dp" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:orientation="vertical" android:visibility="gone" android:background="@drawable/bg_message_ai" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:clipChildren="true" android:clipToPadding="true">

            <LinearLayout android:id="@+id/ai_thinking_toggle_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">

                <TextView android:id="@+id/ai_thinking_toggle_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/gemma_show_thinking" android:textColor="@color/text_secondary" android:textSize="14sp" android:textStyle="bold" android:ellipsize="end" android:maxLines="1" />

                <TextView android:id="@+id/ai_thinking_chevron" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="▼" android:textColor="@color/text_secondary" android:textSize="14sp" android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Bug fix(#Thinking-Layout): layout_height="match_parent" だった縦線 View は、親 (ai_thinking_body) が
                   wrap_content のとき高さ計算が循環し、ComposeView 側の巨大な要望に引きずられて
                   Thinking ブロック全体が枠外にはみ出す原因となっていた。
                   縦線 View は 0dp + weight で意図した高さに追従させ、
                   ai_thinking_body 自体には android:layout_width="match_parent" と android:clipChildren="true" を維持しつつ、内部 ComposeView にも
                   android:maxWidth を設けて枠外はみ出しを完全に防ぐ。 -->
            <LinearLayout android:id="@+id/ai_thinking_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:visibility="gone" android:clipChildren="true" android:clipToPadding="true">

                <View android:layout_width="2dp" android:layout_height="match_parent" android:layout_marginEnd="10dp" android:background="@color/text_secondary" android:alpha="0.35" />

                <androidx.compose.ui.platform.ComposeView android:id="@+id/ai_thinking_markdown_compose" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxWidth="248dp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <androidx.compose.ui.platform.ComposeView android:id="@+id/ai_streaming_tool_call_compose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginBottom="4dp" />

        <TextView android:id="@+id/ai_message_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI response" android:textSize="14sp" android:textColor="@color/text_primary" android:background="@drawable/bg_message_ai" android:padding="11dp" android:maxWidth="280dp" android:textIsSelectable="true" />

        <androidx.compose.ui.platform.ComposeView android:id="@+id/ai_message_markdown_compose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />

        <LinearLayout android:id="@+id/tool_results_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" android:visibility="gone" />

        <!-- タイムスタンプ + t/s・TTFT（生成時刻と同じ列）。アクション行にはボタンのみ。 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="3dp" android:layout_marginStart="4dp">
            <TextView android:id="@+id/ai_message_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14:26" android:textSize="11sp" android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/tv_tps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/bg_perf_meta_chip" android:textSize="11sp" android:textColor="@color/text_secondary" android:visibility="gone" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <LinearLayout android:id="@+id/perf_meta_toggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone" />
        </LinearLayout>

        <!-- Bug fix(#Actions-Always-Visible): copy/speak/regenerate/variant-nav は
               すべて常時表示に戻す（吹き出しタップでの開閉トグルは廃止）。
               性能指標はタイムスタンプ行に表示。 -->
        <LinearLayout android:id="@+id/message_actions_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
            <ImageView android:id="@+id/copy_message_button" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/content_copy_24" android:scaleType="centerInside" android:padding="4dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/copy_all" android:clickable="true" android:focusable="true" app:tint="@color/text_secondary" />
            <ImageView android:id="@+id/speak_message_button" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="2dp" android:src="@drawable/ic_select_to_speak_24" android:scaleType="centerInside" android:padding="6dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="読み上げ" android:clickable="true" android:focusable="true" app:tint="@color/text_secondary" />
            <!-- 応答バリアントナビゲーション (◀ n/m ▶)。応答が複数あるときのみ表示。 -->
            <LinearLayout android:id="@+id/variant_nav_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginStart="4dp" android:visibility="gone">
                <ImageView android:id="@+id/variant_prev_button" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_chevron_left_24" android:scaleType="centerInside" android:padding="2dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="前の応答" android:clickable="true" android:focusable="true" app:tint="@color/text_secondary" />
                <TextView android:id="@+id/variant_page_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="36dp" android:gravity="center" android:text="1/1" android:textSize="11sp" android:textColor="@color/text_secondary" />
                <ImageView android:id="@+id/variant_next_button" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_chevron_right_24" android:scaleType="centerInside" android:padding="2dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="次の応答" android:clickable="true" android:focusable="true" app:tint="@color/text_secondary" />
            </LinearLayout>
            <ImageView android:id="@+id/regenerate_message_button" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="2dp" android:src="@drawable/ic_refresh_24" android:scaleType="centerInside" android:padding="4dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="再生成" android:clickable="true" android:focusable="true" android:visibility="gone" app:tint="@color/text_secondary" />
            <ProgressBar android:id="@+id/speak_message_progress" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="4dp" android:indeterminate="true" android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>

