<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Nezumiai" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nezumi_primary</item>
        <item name="colorOnPrimary">@color/nezumi_on_primary</item>
        <item name="colorPrimaryContainer">@color/nezumi_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/nezumi_on_primary_container</item>
        <item name="colorSecondary">@color/nezumi_primary</item>
        <item name="colorOnSecondary">@color/nezumi_on_primary</item>
        <item name="colorAccent">@color/nezumi_primary</item>
        <item name="android:colorAccent">@color/nezumi_primary</item>
        <item name="colorControlActivated">@color/nezumi_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="materialButtonStyle">@style/Widget.Nezumiai.Button</item>
        <!--
          View 系は system sans-serif を維持（font-provider 起動クラッシュ回避）。
          Compose UI および PDF 書き出しは assets/fonts/static/NotoSansJP-*.ttf を使用する
          （presentation/ui/theme/NezumiTheme.kt / MarkdownToPdfWriter）。
        -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Nezumiai" parent="Base.Theme.Nezumiai" />
</resources>
