-    fun answerOnlyForModelContext(assistantContent: String): String {
-        val t = assistantContent.trim()
-        if (t.isEmpty()) return ""
-        return sanitizeVisibleText(
-            parse(t, preserveToolCallTags = true).answer,
-            preserveToolCallTags = true
