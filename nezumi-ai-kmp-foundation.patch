-        if (afterChannel.isNotEmpty() &&
-            THOUGHT_LABEL.length > afterChannel.length &&
-            THOUGHT_LABEL.startsWith(afterChannel)
-        ) {
-            return null
-        }
-        return afterChannel
-    }
