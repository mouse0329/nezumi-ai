-    private fun removeRedactedThinkingBlocks(text: String): String {
-        var t = text
-        val closed = Regex("(?is)<think>.*?</think>")
-        while (closed.containsMatchIn(t)) {
-            t = t.replace(closed, "")
-        }
-        return t
-    }
